#!/usr/bin/env python3
"""Public lab submission. Requires job.json publicUploadApproved:true."""
import json, os, pathlib, shutil, subprocess, sys, tempfile, time
REPO="Alaaaya/mirsa-lab"
job=pathlib.Path(sys.argv[1]).resolve()
cfg=json.loads((job/"job.json").read_text())
if cfg.get("publicUploadApproved") is not True:
 sys.exit("Refusing public upload. Review source for secrets, then set publicUploadApproved:true in job.json.")
if any(p.is_symlink() for p in job.rglob("*")): sys.exit("Symlinks forbidden")
if sum(p.stat().st_size for p in job.rglob("*") if p.is_file())>20*1024*1024: sys.exit("Job exceeds 20 MiB")
env=dict(os.environ)
env["GH_TOKEN"]=os.environ.get("GH_TOKEN") or (pathlib.Path.home()/".gh_token").read_text().strip()
def gh(*args): return subprocess.check_output(["gh",*args],env=env,text=True).strip()
with tempfile.TemporaryDirectory(prefix="mirsa-lab-") as temp:
 subprocess.run(["git","init","-b","mirsa/job-"+str(time.time_ns()),temp],check=True,stdout=subprocess.DEVNULL)
 shutil.copytree(job,pathlib.Path(temp)/"job")
 def git(*a): return subprocess.check_output(["git","-C",temp,*a],text=True).strip()
 git("config","user.name","Mirsa"); git("config","user.email","noreply")
 git("add","job"); git("commit","-m","Lab input")
 sha=git("rev-parse","HEAD"); branch=git("branch","--show-current")
 # Token never enters URL, git config, job files, logs, or command line.
 askpass=pathlib.Path(temp)/"askpass"
 askpass.write_text('#!/bin/sh\ncase "$1" in *Username*) echo x-access-token;; *) printf "%s\\n" "$GH_TOKEN";; esac\n')
 askpass.chmod(0o700)
 pushenv=dict(env,GIT_ASKPASS=str(askpass),GIT_TERMINAL_PROMPT="0")
 subprocess.run(["git","-C",temp,"-c","credential.helper=","push","https://github.com/"+REPO+".git","HEAD:refs/heads/"+branch],env=pushenv,check=True)
 gh("workflow","run","lab.yml","-R",REPO,"--ref","main","-f","job_ref="+sha)
 # Polling is internal to this synchronous CLI, bounded, resumable via run URL.
 runid=None
 for _ in range(24):
  runs=json.loads(gh("run","list","-R",REPO,"--workflow","lab.yml","--limit","30","--json","databaseId,displayTitle"))
  matches=[r for r in runs if sha in r["displayTitle"]]
  if matches: runid=str(matches[0]["databaseId"]); break
  time.sleep(5)
 if not runid: sys.exit("Dispatch sent but run not indexed for "+sha)
 (job/"lab-run.json").write_text(json.dumps({"sha":sha,"run":runid,"url":"https://github.com/"+REPO+"/actions/runs/"+runid}))
 print("https://github.com/"+REPO+"/actions/runs/"+runid,flush=True)
 watch=subprocess.run(["gh","run","watch",runid,"-R",REPO,"--exit-status","--interval","20"],env=env,timeout=2400)
 output=job/"lab-output"; output.mkdir(exist_ok=True)
 gh("run","download",runid,"-R",REPO,"-n","lab-results","-D",str(output))
 result=json.loads((output/"result.json").read_text())
 print(json.dumps(result,indent=2))
 sys.exit(0 if result["status"]=="pass" and watch.returncode==0 else 1)
